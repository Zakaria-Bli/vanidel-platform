# Copy to /opt/traefik/dns.env (mode 600): cPanel API credentials for the DNS challenge
# (`letsencrypt-dns` resolver). On the existing VPS, this is /opt/vanidel/services/traefik-dns.env.
CPANEL_BASE_URL=https://srv-de-2.nvme-servers.com:2083
CPANEL_USERNAME=
# cPanel → Security → Manage API Tokens. Without an expiry date, or renewals stop when it expires.
CPANEL_TOKEN=
