# ==================================
# APP
# ==================================

# Environment (development/production)
NODE_ENV=development

# At least 32 characters. Generate a unique value with: openssl rand -base64 32
PAYLOAD_SECRET=CHANGE_ME


# ==================================
# DATABASE
# ==================================

# PostgreSQL connection string for a local database.
DATABASE_URL=postgresql://payload:payload-local@127.0.0.1:5432/vanidel


# ==================================
# STORAGE (SeaweedFS, S3 API)
# ==================================

# Leave all unset to keep uploads on local disk (media/, tickets/). Set all of them to use S3;
# all are required in production. See README for a throwaway local SeaweedFS.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Campaign media (hero images, prizes, regulations).
S3_BUCKET_PUBLIC=
# Receipt photos; never readable without Payload access control.
S3_BUCKET_PRIVATE=
