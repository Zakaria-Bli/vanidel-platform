# Production values for docker-compose.yml. Copy to `.env` next to it on the server (mode 600).
# Generate each secret on the server; never reuse the testing environment's values.

# Public domain routed to the app by Traefik. SITE_URL becomes https://<APP_DOMAIN>.
APP_DOMAIN=vanidel.com

# Traefik certificate resolver. `letsencrypt-dns`: DNS challenge through the cPanel API, with
# _acme-challenge.vanidel.com delegated by CNAME (docs/operations/DEPLOYMENT_DOCKER.md). This VPS's
# network drops some of Let's Encrypt's HTTP validation traffic, so `letsencrypt` (HTTP) is unreliable.
TLS_CERT_RESOLVER=letsencrypt-dns

# Hex only (openssl rand -hex 24): it is placed as is in the database URL.
POSTGRES_PASSWORD=

# At least 32 characters: openssl rand -base64 32
PAYLOAD_SECRET=

# The app's SeaweedFS identity. Secret: openssl rand -hex 24
S3_ACCESS_KEY_ID=vanidel-app
S3_SECRET_ACCESS_KEY=
